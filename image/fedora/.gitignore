# Generated by `make image` (scripts/build-image.sh + mkosi).
# Paths are anchored to this directory so tracked static files under
# mkosi.extra/ (services, tests, scripts) are preserved.

# mkosi build outputs (Output=fedora-kvm in mkosi.conf)
/fedora-kvm
/fedora-kvm.raw
/fedora-kvm.efi
/fedora-kvm.initrd
/fedora-kvm.vmlinuz
/fedora-kvm.manifest

# vm-planes initrd cpio staged by build-image.sh
/vm-planes-initrd.cpio

# Generated plane staging under mkosi.extra (static files are kept)
/mkosi.extra/boot/
/mkosi.extra/config-vm-planes
/mkosi.extra/etc/lvbs/
/mkosi.extra/etc/dracut.conf.d/
/mkosi.extra/usr/lib/lvbs/
/mkosi.extra/usr/lib/modules/
